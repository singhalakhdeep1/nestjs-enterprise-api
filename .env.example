# --- Core ---
DATABASE_URL="postgresql://enterprise:enterprise@localhost:5432/enterprise"
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3103
RATE_LIMIT_PER_MINUTE=120

# --- Auth ---
JWT_SECRET="change-me-to-at-least-16-random-characters"
JWT_EXPIRES_IN="1d"

# --- Redis (cache, rate limiting, pub/sub for websockets). Optional: features degrade without it. ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=300
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_RATE=1

# --- Elasticsearch (search). Unset = PostgreSQL search. ---
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=posts
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- RabbitMQ (domain events, topic exchange). Unset = disabled. ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=enterprise.events

# --- EventStoreDB (post event history). Unset = disabled. ---
EVENTSTORE_CONNECTION_STRING=esdb://localhost:2113?tls=false

# --- gRPC (EnterpriseService, src/integrations/proto/enterprise.proto) ---
GRPC_URL=0.0.0.0:50051
GRPC_CLIENT_URL=localhost:50051

# --- GraphQL Federation gateway (npm run start:gateway) ---
GATEWAY_PORT=4001
GRAPHQL_SUBGRAPHS=enterprise=http://localhost:4000/graphql

# --- Webhooks / integrations ---
WEBHOOK_SECRET=change-me-webhook-secret
GITHUB_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=

# --- Seed ---
SEED_PASSWORD=ChangeMe123!
